# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
build/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Certificates & private keys ───────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.csr
*.p12
*.pfx
# SSH key pairs
*_rsa
*_rsa.pub
*_dsa
*_dsa.pub
*_ed25519
*_ed25519.pub
*_ecdsa
id_rsa*
id_dsa*
id_ed25519*

# ── AWS credentials ───────────────────────────────────────────────────────────
.aws/credentials
.aws/sso/cache/

# ── Terraform ─────────────────────────────────────────────────────────────────
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
.terraform/
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it to pin provider versions

# ── Kubernetes ────────────────────────────────────────────────────────────────
kubeconfig*
.kube/
# Real secret manifests — never commit; use *-secret-template.yaml or *.yaml.example for templates
k8s/secrets/
*-secret.yaml
*-secrets.yaml
!*-secret-template.yaml
!*-secret.yaml.example

# ── Build output ──────────────────────────────────────────────────────────────
dist/

